{
  "name": "janus-os (NixOS host)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "dev",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "initializeCommand": "sh .devcontainer/require-host.sh nixos",
  "runArgs": ["--name", "janus-os-nixos"],
  "mounts": [
    "source=/nix,target=/nix,type=bind",
    "source=/run/current-system,target=/run/current-system,type=bind,readonly",
    "source=${localEnv:HOME}/.config/git/config,target=/etc/gitconfig.host,type=bind,readonly",
    "source=${localEnv:HOME}/.config/gh,target=/home/dev/.config/gh,type=bind,readonly",
    "source=${localEnv:XDG_RUNTIME_DIR}/bus,target=/run/host-bus,type=bind",
    "source=/etc/nix/nix.conf,target=/etc/nix/nix.conf,type=bind,readonly"
  ],
  "containerEnv": {
    "DBUS_SESSION_BUS_ADDRESS": "unix:path=/run/host-bus"
  },
  "postCreateCommand": "sudo /opt/devcontainer/realize.sh \"$(id -un)\"",
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
      "terminal.integrated.defaultProfile.linux": "janus-dev",
      "terminal.integrated.profiles.linux": {
        "janus-dev": {
          "path": "nix",
          "args": ["develop", "--command", "zsh"],
          "cwd": "${workspaceFolder}",
          "overrideName": true
        }
      }
    }
    }
  }
}
